# Env for the SPOT services on the AMD box (installed to /root/spot.env by setup.sh). No secrets belong here.
HTTPS_PROXY=http://notebook-egress-proxy.amd-oneclick-lablab.svc.cluster.local:3128
HTTP_PROXY=http://notebook-egress-proxy.amd-oneclick-lablab.svc.cluster.local:3128
NO_PROXY=127.0.0.1,localhost
HF_HOME=/root/.cache/huggingface
# huggingface.co is blocked from the box; hf-mirror serves public repos (base Laya, Qwen3-Embedding)
HF_ENDPOINT=https://hf-mirror.com
# hf-mirror's Xet downloads answer 401; plain HTTP works
HF_HUB_DISABLE_XET=1
TMPDIR=/root/tmp

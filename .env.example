# Root .env for docker-compose.yml. Copy to .env (gitignored) and edit. See docs/RUNNING.md.
# Compose reads this file for ${VAR} interpolation only; your SHELL environment wins over it, so
# `unset DATABASE_URL EMBED_URL SYSTEM1_URL` if you exported localhost URLs for native runs.

# ── Mode ────────────────────────────────────────────────────────────────────────────────────────
# local  : everything in Docker on CPU (default)
# hybrid : db + mcp + backend in Docker, system1 + embed native on the AMD GPU box (set the URLs below)
# neon   : db-init + mcp + backend against Neon (set the three *_DATABASE_URL below); add ",models" for CPU models
COMPOSE_PROFILES=local

# Dashboard features: independently disable with false (details=false also disables actions/explanations).
FEATURE_FLAG_DETAILS=true
FEATURE_FLAG_ACTIONS=true
FEATURE_FLAG_EXPLANATIONS=true
# WEB_EXPLAIN_TIMEOUT_MS=50000   # how long the dashboard waits for /explain (5000-120000); raise for a slow local model

# ── Build ───────────────────────────────────────────────────────────────────────────────────────
TORCH_VARIANT=cpu                 # cpu | rocm-gfx1151 | rocm-gfx1201 (ROCm needs a Linux host with Docker)
BIND_ADDR=127.0.0.1               # host interface for published ports (0.0.0.0 to expose on the LAN)
DB_PORT=5433                      # host port of the local Postgres (change if db/local_pgvector.sh holds 5433)

# ── Database (local/hybrid: the `db` service; these are dev passwords) ──────────────────────────
POSTGRES_PASSWORD=postgres
SPOT_APP_USER=spot_app_user       # backend login, member of spot_app
SPOT_APP_PASSWORD=spot_app_dev
SPOT_MCP_USER=spot_mcp_user       # mcp login (and system1 call logging), member of spot_mcp_reader
SPOT_MCP_PASSWORD=spot_mcp_dev

# ── Neon (profile neon): the owner URL replaces the db service; services log in as the group members ──
# DATABASE_URL=postgresql://neondb_owner:<pw>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# BACKEND_DATABASE_URL=postgresql://spot_app_user:<pw>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# MCP_DATABASE_URL=postgresql://spot_mcp_user:<pw>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# SYSTEM1_LOGS_DATABASE_URL=   # system1's app.model_calls logging (same as MCP_DATABASE_URL), only with --profile models
# DB_INGEST_ARGS=              # e.g. --force after changing EMBED_MODEL
# DB_GRAPH_ARGS=               # knowledge-graph build: --no-embed skips embedding; --force-embed re-embeds all

# ── Models (hybrid: the AMD box; reach it through an SSH tunnel on this machine) ──────────────────
#   ssh -N -L 18082:localhost:8082 -L 18081:localhost:8081 <amd-vm>
# SYSTEM1_URL=http://host.docker.internal:18082
# EMBED_URL=http://host.docker.internal:18081
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024
# System 1 defaults to the fine-tuned Laya: LAYA_CHECKPOINT=Jyler/KnightHacks-Laya-Model,
# LAYA_CHECKPOINT_SUBDIR=run4_B_lora_lr4/best (private: needs HF_TOKEN; without it base Laya loads instead).
# HF_TOKEN=                                          # HF read token for the private checkpoint repo
# LAYA_CHECKPOINT_SUBDIR=run4_B_lora_lr4/best        # another run in the same repo
# LAYA_FALLBACK_CHECKPOINT=convaiinnovations/laya    # empty = fail instead of falling back
# LAYA_CHECKPOINT=/models/checkpoints/run2/best      # or a local run, mounted from LAYA_CHECKPOINT_DIR
# LAYA_CHECKPOINT_DIR=./amd/system1/checkpoints

# ── Shared secrets (dev defaults = compose's defaults; ports bind to 127.0.0.1) ─────────────────────
# Each key is read by both ends of its hop, so set it once here. Change all four before BIND_ADDR=0.0.0.0 or any
# shared host: openssl rand -hex 24 (the gateway key must start with sk-). An empty value is never used: compose
# falls back to the default, so a service can't crash-loop on a missing key (audit P-1).
SYSTEM2_API_KEY=spot-system2-dev-key-change-me              # X-API-Key: backend + orchestrator -> system2 (>= 16 chars)
ORCHESTRATOR_API_KEY=spot-orchestrator-dev-key-change-me    # X-API-Key: backend -> orchestrator (>= 16 chars)
LITELLM_MASTER_KEY=sk-spot-gateway-dev-key-change-me        # Bearer: system2 + orchestrator -> gateway (sk-, >= 16)
VISION_API_KEY=spot-vision-dev-key-change-me                # X-API-Key: orchestrator -> vision (REQUIRED, >= 16 chars)

# ── Backend ─────────────────────────────────────────────────────────────────────────────────────
TRIAGE_MODE=serial                # serial (Laya flags, rules confirm) | parallel (either escalates)
# Admin token for /api/v1/ops/*, /api/v1/replay/* and POST /api/v1/events* (header X-Admin-Token). Unset -> those
# endpoints answer 503 (closed, never open). `make e2e` reads it from this file. Generate: openssl rand -hex 24
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:3000    # the dashboard's origin(s), comma-separated
# REQUEST_DEADLINE_S=45               # overall deadline for /flags/{id}/context and /explain
# SYSTEM2_URL=http://host.docker.internal:8083   # default http://system2:8083; empty -> /explain returns the template
# ORCHESTRATOR_URL=http://orchestrator:8085      # opt-in: /explain asks the LangGraph orchestrator first, /api/v1/ask on
# ORCHESTRATOR_TIMEOUT_S=42                      # = REQUEST_DEADLINE_S - 3 s reserve (orchestrator deadline: 40)
# MCP_AUTH_TOKEN=                 # set when the MCP port is exposed beyond localhost
# Timeouts are sized for CPU; on the AMD GPU the contract defaults are fine:
# SYSTEM1_TIMEOUT_S=5  SYSTEM1_INGEST_TIMEOUT_S=5  EMBED_TIMEOUT_S=10  SEARCH_EMBED_TIMEOUT_S=4  MCP_TIMEOUT_S=15

# ── Model gateway (amd/gateway, :4000; LiteLLM) ─────────────────────────────────────────────────
# LLAMA_URL=http://host.docker.internal:18080       # llama-server (System 2 text) via ssh -N -L 18080:127.0.0.1:8080 <amd>
# VISION_LLAMA_URL=                                  # separate llama-server with --mmproj; empty = LLAMA_URL
# LLAMA_API_KEY=                                     # llama-server --api-key, if set
# GATEWAY_PORT=4000
# GATEWAY_SYSTEM2_TIMEOUT_S=15  GATEWAY_VISION_TIMEOUT_S=30  GATEWAY_SYSTEM1_TIMEOUT_S=10  GATEWAY_EMBED_TIMEOUT_S=10

# ── System 2 live mode (empty SYSTEM2_LLAMA_URL = stub) ─────────────────────────────────────────
# SYSTEM2_LLAMA_URL=http://gateway:4000              # through the gateway (or llama-server directly)
# SYSTEM2_MODEL=qwen3.5-9b-q4km                      # hidden gateway alias of `system2`; keeps explanation cache keys
# SYSTEM2_VISION_MODEL=system2-vision                # requests with image_b64 only (compose default)
# SYSTEM2_LLAMA_API_KEY=                             # compose default: LITELLM_MASTER_KEY; set by hand for native runs
# SYSTEM2_DEADLINE_S=15                              # System 2 deadline for text requests (p95 target)
# SYSTEM2_IMAGE_DEADLINE_S=25                        # System 2 deadline for requests with an image (text: 15 s)

# ── Vision / OCR (amd/vision, :8084) ────────────────────────────────────────────────────────────
# VISION_URL=http://vision:8084                      # the orchestrator's vision endpoint (empty = no vision)
# VISION_API_KEY: REQUIRED by the vision service (>= 16 chars); set in the shared-secrets block above
# VISION_MAX_IMAGE_BYTES=12000000  VISION_MAX_PIXELS=12000000  VISION_WORK_MAX_SIDE=1280  VISION_CACHE_SIZE=64
# VISION_MAX_CONCURRENCY=2  VISION_QUEUE_TIMEOUT_S=3  # at most 2 analyses at once, then 503 after 3 s

# ── Orchestrator (amd/orchestrator, :8085; LangGraph) ───────────────────────────────────────────
# GATEWAY_URL=http://gateway:4000
# DEMO_IMAGES=1                                      # pair kit sample images by action type (pairing "demo")
# ORCH_DEADLINE_S=40                                 # keep below REQUEST_DEADLINE_S (45)
# ORCH_SYSTEM2_BUDGET_S=20  ORCH_SYSTEM2_IMAGE_BUDGET_S=28  ASK_DEADLINE_S=30  ASK_MAX_TOOL_CALLS=4

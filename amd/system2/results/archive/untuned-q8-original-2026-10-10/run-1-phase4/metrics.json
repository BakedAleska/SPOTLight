  "limitations": [
    {
      "requirement": "EVAL-02",
      "item": "claim support judged by a different model",
      "status": "not built",
      "note": "Only the mechanical part is reported: schema, citation-ID, numeric and name consistency with the cited packet content."
    },
    {
      "requirement": "EVAL-03",
      "item": "LLM-vs-template judge rubric",
      "status": "not built",
      "note": "No judge model scores usefulness or clarity; model and template are compared on mechanical checks only."
    },
    {
      "requirement": "EVAL-04",
      "item": "action quality against human labels",
      "status": "not built",
      "note": "Only agreement with the validator's suggested_action is reported. That is agreement, not accuracy."
    },
    {
      "requirement": "EVAL-07",
      "item": "judge-vs-human agreement",
      "status": "not built",
      "note": "Neither a judge nor human labels exist, so their agreement cannot be measured."
    },
    {
      "requirement": "grounding",
      "item": "entailment / correctness of claims",
      "status": "not built",
      "note": "Grounding means mechanical consistency with cited packet content (not entailment, not correctness)."
    },
    {
      "requirement": "comparison",
      "item": "evidence that the model beats the template",
      "status": "not built",
      "note": "The template passes the mechanical checks by construction (it copies cited rows), so mechanical parity is expected and is not evidence that the model is better."
    },
    {
      "requirement": "sample size",
      "item": "tight intervals",
      "status": "not built",
      "note": "n is small (38 flags in 8 held-out missions), so the mission-level CIs are wide."
    },
    {
      "requirement": "data",
      "item": "independent real-world observations",
      "status": "not built",
      "note": "\"Real\" means sponsor kit missions as opposed to simulator output; the kit itself carries synthetic=True metadata. No synthetic or unrestricted-retrieval results are included."
    }
  ]
